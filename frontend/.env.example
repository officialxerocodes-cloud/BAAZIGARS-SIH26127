# -------------------------------------------------------------------
# VAHAN-NETRA frontend environment
# Copy to .env when you need to override the default API routing.
# -------------------------------------------------------------------

# Backend API base URL (bare origin ONLY — no /api suffix; paths already
# include it, so a suffix would double to /api/api/... and 404).
#   * Leave EMPTY (default) -> the frontend calls /api on its own origin and
#     the Vite dev proxy (vite.config.js) forwards to http://localhost:8002.
#   * Set a full URL -> the frontend calls the backend cross-origin directly,
#     e.g. VITE_API_BASE_URL=http://localhost:8002  (backend must permit
#     this origin via CORS_ORIGINS on the API service).
VITE_API_BASE_URL=